# MATLAB
*.asv
*.m~
*.mex*
*.slxc
*.autosave
# Simulink models and simulation outputs are regenerated by the .m
# scripts that build them — keep the source script, not the artifact.
matlab/*.slx
matlab/*.mat
matlab/data/*.mat
matlab/data/*.csv
matlab/data/*.log

# Stray dir from a path bug in early script runs (already cleaned once)
matlab/scripts/matlab/

# External MATLAB-File-Exchange downloads (reference only, not source)
Virtual_synchronous_generator_control2016*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
python/plots/*.png
python/plots/*.pdf
python/plots/*.csv
.ipynb_checkpoints/

# VS Code
.vscode/settings.json
.vscode/launch.json

# OS
Thumbs.db
.DS_Store
desktop.ini

# Large reference files (store in NotebookLM instead)
docs/references/*.pdf

# Bloated proposal artifacts at docs/ root — slide decks and PDF/DOCX
# exports are regenerated from the .py builders (or via NotebookLM).
docs/*.pptx
docs/*.pdf
docs/*.docx
docs/notes/*.pdf

# Private chat exports (e.g. LINE chat history with advisor)
# Brackets must be escaped in gitignore — unescaped [LINE] reads as
# a character class matching any of L,I,N,E.
\[LINE\]*.txt

# Word/Office lock and recovery files (created while a doc is open)
~$*.docx
~$*.pptx
*.tmp

# Dated backup snapshots — keep the live deliverable, not the backups
*.backup-*.docx

# docs/notes is scratch: slide decks (regenerated from the .py builders)
# and superseded proposal docx drafts. Markdown/txt notes ARE tracked.
docs/notes/*.pptx
docs/notes/*.docx
matlab/*.log

# Keep raw runs and backups local; publish current small evidence and models.
matlab/validation_outputs/*
!matlab/validation_outputs/motor_ideal_source/
!matlab/validation_outputs/stage5[d-h]/
matlab/validation_outputs/*/*
!matlab/validation_outputs/motor_ideal_source/*.json
!matlab/validation_outputs/stage5[d-h]/*.json
!matlab/validation_outputs/stage5d/vsg_stage5d.slx
!matlab/validation_outputs/stage5h/vsg_stage5h_mosfet.slx
!matlab/validation_outputs/stage5h/vsg_stage5h_mosfet_layout.slx

# Local dependencies and investigation scratch files
python/.deps_stage5h/
/tmp/
docs/figures/*_INCOMPLETE_EXPORT.png
