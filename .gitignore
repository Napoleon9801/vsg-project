# MATLAB
*.asv
*.m~
*.mex*
*.slxc
*.autosave
# Simulink models and simulation outputs are regenerated by the .m
# scripts that build them — keep the source script, not the artifact.
matlab/*.slx
matlab/*.mat
matlab/data/*.mat
matlab/data/*.csv

# External MATLAB-File-Exchange downloads (reference only, not source)
Virtual_synchronous_generator_control2016*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
python/plots/*.png
python/plots/*.pdf
.ipynb_checkpoints/

# VS Code
.vscode/settings.json
.vscode/launch.json

# OS
Thumbs.db
.DS_Store
desktop.ini

# Large reference files (store in NotebookLM instead)
docs/references/*.pdf
